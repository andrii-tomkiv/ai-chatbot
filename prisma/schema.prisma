generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserRequests {
  id       Int      @id @default(autoincrement())
  userIP   String
  message  String   @db.Text
  response String   @db.LongText
  date     DateTime @default(now())
}
